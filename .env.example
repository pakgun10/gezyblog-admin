# Salin ke .env (VPS) atau ke Environment systemd. JANGAN commit berkas .env.
PORT=3101
# Clone repo blog di VPS, mis. /opt/gezyblog/blog (bukan repo kode admin ini).
BLOG_REPO=/opt/gezyblog/blog
BLOG_PUBLIC_URL=https://pakgun.gezytech.web.id
ADMIN_USER=admin
# Hasil dari: printf 'sandi-anda' | bun run scripts/hash-password.ts
ADMIN_PASS_HASH=
# 1 bila di belakang Caddy HTTPS, 0 bila uji lokal http://localhost.
SESSION_SECURE=1
# 1 = push ke GitHub saat simpan; 0 = commit lokal saja (untuk uji).
ALLOW_PUSH=1
